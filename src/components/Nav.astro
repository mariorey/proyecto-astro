---
export interface Props {
    lang: 'es' | 'en';
    activePage?: 'home' | 'about' | 'projects';
    altHref: string; // URL to the same page in the other language
}

const { lang, activePage, altHref } = Astro.props;

const isES = lang === 'es';

const links = isES
    ? {
        home: '/proyecto-astro',
        about: '/proyecto-astro/about-me',
        projects: '/proyecto-astro/#projects',
        contact: 'mailto:lalaburjack@gmail.com',
    }
    : {
        home: '/proyecto-astro/en',
        about: '/proyecto-astro/en/about-me',
        projects: '/proyecto-astro/en#projects',
        contact: 'mailto:lalaburjack@gmail.com',
    };

const esHref = isES ? Astro.url.pathname : altHref;
const enHref = isES ? altHref : Astro.url.pathname;
---

<nav>
    <button
            class="nav-burger"
            aria-label={isES ? 'Abrir menú' : 'Open menu'}
            id="nav-burger-btn"
    >
        <span></span>
        <span></span>
        <span></span>
    </button>

    <a class="nav-logo" href={links.home}>
        <span class="nav-logo-name">Ana Burjack</span>
        <span class="nav-logo-role">UX/UI Designer</span>
    </a>

    <ul class="nav-center" id="nav-menu">
        <li>
            <a href={links.about} class={activePage === 'about' ? 'active1' : ''}>
                About Me
            </a>
        </li>
        <li>
            <a href={links.projects} class={activePage === 'projects' ? 'active' : ''}>
                {isES ? 'Proyectos' : 'Projects'}
            </a>
        </li>
        <li>
            <a href={links.contact}>Contact</a>
        </li>
        <li class="mobile-lang">
            <a href={esHref} class={isES ? 'active' : ''}>ES</a>
            <span>/</span>
            <a href={enHref} class={!isES ? 'active' : ''}>EN</a>
        </li>
    </ul>

    <div class="nav-right">
        <div class="lang-switcher">
            <a href={esHref} class={isES ? 'active' : ''}>ES</a>
            <span>/</span>
            <a href={enHref} class={!isES ? 'active' : ''}>EN</a>
        </div>
        <a href="https://www.linkedin.com/in/anaburjack-designerux-ui/" target="_blank" rel="noopener">
            <svg width="29" height="28" viewBox="0 0 29 28" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6.08605 3.11249C6.08564 3.93757 5.76465 4.72868 5.19369 5.3118C4.62273 5.89493 3.84856 6.22229 3.0415 6.22188C2.23444 6.22146 1.4606 5.89331 0.890205 5.3096C0.319813 4.7259 -0.000403149 3.93446 3.80928e-07 3.10938C0.000403911 2.28431 0.321394 1.4932 0.892357 0.910073C1.46332 0.326951 2.23748 -0.000412147 3.04454 3.8943e-07C3.8516 0.000412925 4.62545 0.328567 5.19584 0.912273C5.76623 1.49598 6.08645 2.28742 6.08605 3.11249ZM6.17734 8.52553H0.091291V28H6.17734V8.52553ZM15.7933 8.52553H9.73767V28H15.7324V17.7806C15.7324 12.0876 22.99 11.5587 22.99 17.7806V28H29V15.6651C29 6.06789 18.2581 6.42564 15.7324 11.1387L15.7933 8.52553Z" fill="black"/>
            </svg>
        </a>
    </div>
</nav>

<script>
    const burger = document.getElementById('nav-burger-btn');
    const menu = document.getElementById('nav-menu');
    if (burger && menu) {
        burger.addEventListener('click', () => {
            burger.classList.toggle('active');
            menu.classList.toggle('open');
        });
    }
</script>