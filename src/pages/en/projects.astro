---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Projects — Ana Burjack" lang="en" description="Selected UX/UI design case studies.">
    <Nav lang="en" activePage="projects" altHref="/projects" />

    <section class="projects-header">
        <div class="projects-header-top">
            <h1 class="projects-header-title"><em>Projects</em></h1>
            <span class="projects-header-count">( 3 )</span>
        </div>
        <p class="projects-header-sub">Selected work &middot; 2024&ndash;2025</p>
    </section>

    <div class="projects-list">
        <a class="project-card" href="/en/tedeache-prototype" data-reveal>
            <span class="project-card-num">01</span>
            <div class="project-card-info">
                <span class="project-tag">Mobile App</span>
                <h2 class="project-card-title">Tedeache</h2>
                <p class="project-card-desc">App designed to improve the daily routine of people with ADHD, helping them stay organised, reduce procrastination, and manage digital distractions.</p>
            </div>
            <div class="project-card-img-wrap">
                <img src="/files/tedeache/cover.png" alt="Tedeache" transition:name="cover-tedeache" />
            </div>
        </a>

        <a class="project-card" href="/en/agape" data-reveal>
            <span class="project-card-num">02</span>
            <div class="project-card-info">
                <span class="project-tag">Web Design</span>
                <h2 class="project-card-title">Ágape</h2>
                <p class="project-card-desc">Website design for a fictional supermarket featuring innovative functionalities focused on usability and the online shopping experience.</p>
            </div>
            <div class="project-card-img-wrap">
                <img src="/files/agape/cover-agape.png" alt="Ágape" transition:name="cover-agape" />
            </div>
        </a>

        <a class="project-card" href="/en/mentalizt" data-reveal>
            <span class="project-card-num">03</span>
            <div class="project-card-info">
                <span class="project-tag">Mobile App</span>
                <h2 class="project-card-title">MentaliZT</h2>
                <p class="project-card-desc">App designed to improve mental health and reduce the effects of stress, combining mindfulness tools and emotional management features.</p>
            </div>
            <div class="project-card-img-wrap">
                <img src="/files/mentalizt/cover.png" alt="MentaliZT" transition:name="cover-mentalizt" />
            </div>
        </a>
    </div>

    <Footer />
</BaseLayout>
