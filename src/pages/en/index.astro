---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Ana Burjack — UX/UI Designer" lang="en" description="Designing intuitive and functional digital experiences.">
    <Nav lang="en" activePage="home" altHref="/proyecto-astro/" />

    <!-- HERO -->
    <section class="hero">
        <div class="deco" aria-hidden="true">
            <svg viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="250" cy="250" r="240" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="175" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="100" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="3" fill="#111010"/>
                <line x1="250" y1="4" x2="250" y2="496" stroke="#111010" stroke-width="0.5"/>
                <line x1="4" y1="250" x2="496" y2="250" stroke="#111010" stroke-width="0.5"/>
                <line x1="80" y1="80" x2="420" y2="420" stroke="#111010" stroke-width="0.4" stroke-dasharray="4 8"/>
                <line x1="420" y1="80" x2="80" y2="420" stroke="#111010" stroke-width="0.4" stroke-dasharray="4 8"/>
                <path d="M250 10 A240 240 0 0 1 490 250" stroke="#111010" stroke-width="1.5"/>
            </svg>
        </div>

        <div class="hero-content">
            <span class="hero-label">Based in Córdoba · Madrid</span>
            <h1 class="hero-title">
                ux/ui<br />
                <em>designer</em>
            </h1>
            <p class="hero-sub">
                focused on <strong>creating accessible, inclusive</strong> digital experiences that connect strategy, aesthetics and usability.
            </p>
            <a class="hero-cta" href="/proyecto-astro/en#projects">
                <span class="cta-text">View Projects</span>
            </a>
        </div>

        <div class="avail">
            <span class="dot"></span>
            Available for work
        </div>
    </section>

    <!-- PROJECTS -->
    <div id="projects" class="project-row">
        <a href="/proyecto-astro/en/tedeache-prototype">
            <div class="project-img">
                <img src="/proyecto-astro/files/tedeache/cover.png" class="img-placeholder" alt="Tedeache" />
            </div>
        </a>
        <div class="project-info">
            <div class="project-info-wrapper">
                <span class="project-tag">Mobile App</span>
                <a href="/proyecto-astro/en/tedeache-prototype"><h2 class="project-title">Tedeache</h2></a>
            </div>
            <p class="project-desc">App designed to improve the daily routine of people with ADHD, helping them stay organized, reduce procrastination, and manage digital distractions.</p>
            <a class="project-link" href="/proyecto-astro/en/tedeache-prototype">View Case Study →</a><br />
            <a class="project-link-2" href="/proyecto-astro/en/tedeache-prototype">View Prototypes</a>
        </div>
    </div>

    <div class="project-row reverse">
        <a href="/proyecto-astro/en/agape">
            <div class="project-img">
                <img src="/proyecto-astro/files/agape/cover-agape.png" class="img-placeholder" alt="Ágape" />
            </div>
        </a>
        <div class="project-info">
            <div class="project-info-wrapper">
                <span class="project-tag">Web Design</span>
                <a href="/proyecto-astro/en/agape"><h2 class="project-title">Ágape</h2></a>
            </div>
            <p class="project-desc">Website design for a fictional supermarket featuring innovative functionalities focused on usability and the online shopping experience.</p>
            <a class="project-link" href="/proyecto-astro/en/agape">View Case Study →</a><br />
            <a class="project-link-2" href="/proyecto-astro/en/agape-prototype">View Prototypes</a>
        </div>
    </div>

    <div class="project-row">
        <a href="/proyecto-astro/en/mentalizt">
            <div class="project-img">
                <img src="/proyecto-astro/files/mentalizt/cover-2.jpg" class="img-placeholder" alt="MentaliZT" />
            </div>
        </a>
        <div class="project-info">
            <div class="project-info-wrapper">
                <span class="project-tag">Mobile App</span>
                <a href="/proyecto-astro/en/mentalizt"><h2 class="project-title">MentaliZT</h2></a>
            </div>
            <p class="project-desc">App designed to improve mental health and reduce the effects of stress.</p>
            <a class="project-link" href="/proyecto-astro/en/mentalizt">View Case Study →</a><br />
            <a class="project-link-2" href="/proyecto-astro/en/mentalizt-prototype">View Prototypes</a>
        </div>
    </div>

    <Footer />
</BaseLayout>