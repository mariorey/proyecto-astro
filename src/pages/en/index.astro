---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout
    title="Ana Burjack — UX/UI Designer"
    lang="en"
    description="UX/UI Designer based in Córdoba · Madrid. I craft accessible, inclusive and user-centred digital experiences."
>
    <Nav lang="en" activePage="home" altHref="/" />

    <!-- HERO -->
    <section class="hero">
        <div class="deco" aria-hidden="true">
            <svg viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="250" cy="250" r="240" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="175" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="100" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="3" fill="#111010"/>
                <line x1="250" y1="4" x2="250" y2="496" stroke="#111010" stroke-width="0.5"/>
                <line x1="4" y1="250" x2="496" y2="250" stroke="#111010" stroke-width="0.5"/>
                <line x1="80" y1="80" x2="420" y2="420" stroke="#111010" stroke-width="0.4" stroke-dasharray="4 8"/>
                <line x1="420" y1="80" x2="80" y2="420" stroke="#111010" stroke-width="0.4" stroke-dasharray="4 8"/>
                <path d="M250 10 A240 240 0 0 1 490 250" stroke="#111010" stroke-width="1.5"/>
            </svg>
        </div>

        <div class="hero-content">
            <span class="hero-label">Based in Córdoba · Madrid</span>
            <h1 class="hero-title">
                <span class="hero-line-1">ux/ui</span><br />
                <em class="hero-line-2">designer</em>
            </h1>
            <p class="hero-sub">
                focused on <strong>creating accessible, inclusive</strong> digital experiences that connect strategy, aesthetics and usability.
            </p>
            <a class="hero-cta" href="/en/projects">
                <span class="cta-text">View Projects</span>
            </a>
        </div>

        <div class="avail">
            <span class="dot"></span>
            Available for work
        </div>
    </section>

    <!-- PROJECTS -->
    <div id="projects" class="project-row">
        <a href="/en/tedeache-prototype" data-reveal="img" data-cursor="view">
            <div class="project-img" data-overlay="View Case Study →">
                <img src="/files/tedeache/cover.png" class="img-placeholder" alt="Case study cover — Tedeache, mobile app for people with ADHD" />
            </div>
        </a>
        <div class="project-info" data-reveal="info">
            <div class="project-info-wrapper">
                <span class="project-tag">Mobile App</span>
                <a href="/en/tedeache-prototype"><h2 class="project-title">Tedeache</h2></a>
            </div>
            <p class="project-desc">App designed to improve the daily routine of people with ADHD, helping them stay organized, reduce procrastination, and manage digital distractions.</p>
            <a class="project-link" href="/en/tedeache-prototype">View Case Study →</a><br />
            <a class="project-link-2" href="/en/tedeache-prototype">View Prototypes</a>
        </div>
    </div>

    <div class="project-row reverse">
        <a href="/en/agape" data-reveal="img" data-cursor="view">
            <div class="project-img" data-overlay="View Case Study →">
                <img src="/files/agape/cover-agape.png" class="img-placeholder" alt="Case study cover — Ágape, web design for an online supermarket" />
            </div>
        </a>
        <div class="project-info" data-reveal="info">
            <div class="project-info-wrapper">
                <span class="project-tag">Web Design</span>
                <a href="/en/agape"><h2 class="project-title">Ágape</h2></a>
            </div>
            <p class="project-desc">Website design for a fictional supermarket featuring innovative functionalities focused on usability and the online shopping experience.</p>
            <a class="project-link" href="/en/agape">View Case Study →</a><br />
            <a class="project-link-2" href="/en/agape-prototype">View Prototypes</a>
        </div>
    </div>

    <div class="project-row">
        <a href="/en/mentalizt" data-reveal="img" data-cursor="view">
            <div class="project-img" data-overlay="View Case Study →">
                <img src="/files/mentalizt/cover-2.jpg" class="img-placeholder" alt="Case study cover — MentaliZT, mobile app for mental wellbeing and stress management" />
            </div>
        </a>
        <div class="project-info" data-reveal="info">
            <div class="project-info-wrapper">
                <span class="project-tag">Mobile App</span>
                <a href="/en/mentalizt"><h2 class="project-title">MentaliZT</h2></a>
            </div>
            <p class="project-desc">App designed to improve mental health and reduce the effects of stress.</p>
            <a class="project-link" href="/en/mentalizt">View Case Study →</a><br />
            <a class="project-link-2" href="/en/mentalizt-prototype">View Prototypes</a>
        </div>
    </div>

    <!-- ABOUT TEASER -->
    <section class="about-teaser" data-reveal>
        <img src="/files/profile.jpg" class="about-teaser-photo" alt="Ana Burjack" />
        <div class="about-teaser-body">
            <span class="about-teaser-name">Ana Burjack</span>
            <p class="about-teaser-bio">UX/UI designer with a Fine Arts background, passionate about creating accessible digital experiences that connect strategy, aesthetics and usability.</p>
            <a class="about-teaser-link" href="/en/about-me">About me →</a>
        </div>
    </section>

    <Footer />
</BaseLayout>