---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Ana Burjack — UX/UI Designer" lang="es">
    <Nav lang="es" activePage="home" altHref="/en" />

    <!-- HERO -->
    <section class="hero">
        <div class="deco" aria-hidden="true">
            <svg viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="250" cy="250" r="240" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="175" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="100" stroke="#111010" stroke-width="0.8"/>
                <circle cx="250" cy="250" r="3" fill="#111010"/>
                <line x1="250" y1="4" x2="250" y2="496" stroke="#111010" stroke-width="0.5"/>
                <line x1="4" y1="250" x2="496" y2="250" stroke="#111010" stroke-width="0.5"/>
                <line x1="80" y1="80" x2="420" y2="420" stroke="#111010" stroke-width="0.4" stroke-dasharray="4 8"/>
                <line x1="420" y1="80" x2="80" y2="420" stroke="#111010" stroke-width="0.4" stroke-dasharray="4 8"/>
                <path d="M250 10 A240 240 0 0 1 490 250" stroke="#111010" stroke-width="1.5"/>
            </svg>
        </div>

        <div class="hero-content">
            <span class="hero-label">Based in Córdoba · Madrid</span>
            <h1 class="hero-title">
                ux/ui<br />
                <em>designer</em>
            </h1>
            <p class="hero-sub">
                enfocada en <strong>crear experiencias</strong> digitales <strong>accesibles e inclusivas</strong> que conecten estrategia, estética y usabilidad.
            </p>
            <a class="hero-cta" href="/#projects">
                <span class="cta-text">Ver Projects</span>
            </a>
        </div>

        <div class="avail">
            <span class="dot"></span>
            Available for work
        </div>
    </section>

    <!-- PROJECTS -->
    <div id="projects" class="project-row">
        <a href="/tedeache">
            <div class="project-img">
                <img src="/proyecto-astro/files/tedeache/cover.png" class="img-placeholder" alt="Tedeache" />
            </div>
        </a>
        <div class="project-info">
            <div class="project-info-wrapper">
                <span class="project-tag">Aplicación Móvil</span>
                <a href="/tedeache"><h2 class="project-title">Tedeache</h2></a>
            </div>
            <p class="project-desc">Aplicación orientada a mejorar la rutina de personas con TDAH, ayudándolas a organizarse, reducir la procrastinación y gestionar distracciones digitales.</p>
            <a class="project-link" href="/tedeache">Ver Case Study →</a><br />
            <a class="project-link-2" href="/tedeache-prototype">Ver Prototipos</a>
        </div>
    </div>

    <div class="project-row reverse">
        <a href="/agape">
            <div class="project-img">
                <img src="/proyecto-astro/files/agape/cover-agape.png" class="img-placeholder" alt="Ágape" />
            </div>
        </a>
        <div class="project-info">
            <div class="project-info-wrapper">
                <span class="project-tag">Diseño Web</span>
                <a href="/agape"><h2 class="project-title">Ágape</h2></a>
            </div>
            <p class="project-desc">Diseño de una página web para un supermercado ficticio con funcionalidades innovadoras enfocadas en la usabilidad y la experiencia de compra online.</p>
            <a class="project-link" href="/agape">Ver Case Study →</a><br />
            <a class="project-link-2" href="/agape-prototype">Ver Prototipos</a>
        </div>
    </div>

    <div class="project-row">
        <a href="/mentalizt">
            <div class="project-img">
                <img src="/proyecto-astro/files/mentalizt/cover-2.jpg" class="img-placeholder" alt="MentaliZT" />
            </div>
        </a>
        <div class="project-info">
            <div class="project-info-wrapper">
                <span class="project-tag">Aplicación Móvil</span>
                <a href="/mentalizt"><h2 class="project-title">MentaliZT</h2></a>
            </div>
            <p class="project-desc">Aplicación orientada a mejorar la salud mental y reducir los efectos del estrés.</p>
            <a class="project-link" href="/mentalizt">Ver Case Study →</a><br />
            <a class="project-link-2" href="/mentalizt-prototype">Ver Prototipos</a>
        </div>
    </div>

    <Footer />
</BaseLayout>