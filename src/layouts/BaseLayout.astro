---
export interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = 'Diseño de experiencias digitales intuitivas y funcionales.',
    lang = 'es',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta property="og:title" content="Ana Burjack | UX/UI Designer" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://anaburjack.es/files/logo.png" />
    <link rel="icon" type="image/x-icon" href="/files/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,900;1,900&family=Instrument+Serif:ital@0;1&family=Outfit:wght@300;400&display=swap"
            rel="stylesheet"
    />
</head>
<body>
<slot />
</body>
</html>

<style is:global>
    @import '../styles/global.css';
</style>