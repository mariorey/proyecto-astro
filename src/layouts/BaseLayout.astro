---
export interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = 'Diseño de experiencias digitales intuitivas y funcionales.',
    lang = 'es',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta property="og:title" content="Ana Burjack | UX/UI Designer" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://anaburjack.es/files/logo.png" />
    <link rel="icon" type="image/x-icon" href="/proyecto-astro/files/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,900;1,900&family=Instrument+Serif:ital@0;1&family=Outfit:wght@300;400&display=swap"
            rel="stylesheet"
    />
</head>
<body>
<!-- Custom cursor -->
<div id="cursor-dot"  aria-hidden="true"></div>
<div id="cursor-ring" aria-hidden="true"></div>

<slot />

<script>
    /* ── Scroll reveal ── */
    const io = new IntersectionObserver(
        entries => entries.forEach(e => {
            if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
            }
        }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));

    /* ── Custom cursor (fine-pointer devices only) ── */
    const dot  = document.getElementById('cursor-dot');
    const ring = document.getElementById('cursor-ring');

    if (dot && ring && window.matchMedia('(pointer: fine)').matches) {
        document.body.classList.add('custom-cursor');
        /* Start hidden — appear on first real mouse move */
        dot.classList.add('cursor-hidden');
        ring.classList.add('cursor-hidden');

        let mouseX = 0, mouseY = 0;
        let ringX  = 0, ringY  = 0;

        /* Dot snaps instantly; ring lags behind via lerp */
        document.addEventListener('mousemove', e => {
            mouseX = e.clientX;
            mouseY = e.clientY;
            dot.style.transform = `translate(${mouseX}px, ${mouseY}px)`;
            dot.classList.remove('cursor-hidden');
            ring.classList.remove('cursor-hidden');
        });

        document.addEventListener('mouseleave', () => {
            dot.classList.add('cursor-hidden');
            ring.classList.add('cursor-hidden');
        });

        /* RAF loop — ring follows with smooth lag */
        function lerp(a: number, b: number, t: number) { return a + (b - a) * t; }
        (function tick() {
            ringX = lerp(ringX, mouseX, 0.1);
            ringY = lerp(ringY, mouseY, 0.1);
            ring.style.transform = `translate(${ringX}px, ${ringY}px)`;
            requestAnimationFrame(tick);
        })();

        /* Hover state: ring morphs on interactive elements */
        document.querySelectorAll('a, button').forEach(el => {
            el.addEventListener('mouseenter', () => ring.classList.add('cursor-hover'));
            el.addEventListener('mouseleave', () => ring.classList.remove('cursor-hover'));
        });

        /* Click feedback on the dot */
        document.addEventListener('mousedown', () => dot.classList.add('cursor-click'));
        document.addEventListener('mouseup',   () => dot.classList.remove('cursor-click'));
    }
</script>
</body>
</html>

<style is:global>
    @import '../styles/global.css';
</style>