---
import { ViewTransitions } from 'astro:transitions';

export interface Props {
    title: string;
    description?: string;
    lang?: string;
}

const {
    title,
    description = 'Diseño de experiencias digitales intuitivas y funcionales.',
    lang = 'es',
} = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta property="og:title" content="Ana Burjack | UX/UI Designer" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://anaburjack.es/files/logo.png" />
    <link rel="icon" type="image/x-icon" href="/proyecto-astro/files/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
            href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,900;1,900&family=Instrument+Serif:ital@0;1&family=Outfit:wght@300;400&display=swap"
            rel="stylesheet"
    />
    <ViewTransitions />
</head>
<body>
<!-- Scroll progress bar -->
<div id="progress-bar" aria-hidden="true" transition:persist></div>

<slot />

<script>
    /* ── Progress bar + nav scroll state ──────────────────────────
       One-time setup — window listeners survive View Transitions   */
    const bar = document.getElementById('progress-bar');

    window.addEventListener('scroll', () => {
        const { scrollTop, scrollHeight, clientHeight } = document.documentElement;
        if (bar) bar.style.transform = `scaleX(${scrollTop / (scrollHeight - clientHeight)})`;
        const nav = document.querySelector('nav');
        if (nav) nav.classList.toggle('scrolled', scrollTop > 80);
    }, { passive: true });

    /* ── Scroll reveal ─────────────────────────────────────────────
       Called directly AND via astro:page-load.
       Direct call guards against the race condition where the event
       fires before this module finishes registering its listener.
       The event call handles every subsequent View Transitions swap. */
    function initReveal() {
        const io = new IntersectionObserver(
            entries => entries.forEach(e => {
                if (e.isIntersecting) {
                    e.target.classList.add('is-visible');
                    io.unobserve(e.target);
                }
            }),
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('[data-reveal]').forEach(el => io.observe(el));
    }

    initReveal();
    document.addEventListener('astro:page-load', initReveal);
</script>
</body>
</html>

<style is:global>
    @import '../styles/global.css';
</style>